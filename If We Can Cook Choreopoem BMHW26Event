  <div class="section">
    <div class="section-header">
      <h2 class="section-title">Village in Action</h2>
      <p class="section-subtitle">Food, community, and sacred connection</p>
    </div>
    
    <div class="gallery-grid">
      <div class="gallery-item">
        <img src="Sacred_Birth_Work_Pic.jpg" alt="Birth workers in circle, dressed in white, practicing sacred birth work">
